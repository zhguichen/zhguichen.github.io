---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = Astro.url.pathname.startsWith('/zh/') ? 'zh' : 'en';
---

<BaseLayout title={lang === 'zh' ? '页面不存在' : 'Page not found'} description={lang === 'zh' ? '找不到你要访问的页面。' : 'The page you are looking for could not be found.'} lang={lang}>
  <section class="not-found">
    <p class="eyebrow"><span></span>404 / Not found</p>
    <h1>{lang === 'zh' ? '这条索引<br />还没有建立。' : 'This index<br />has not been built yet.'}</h1>
    <p>{lang === 'zh' ? '链接可能已经移动，或者这篇笔记仍在整理中。' : 'The link may have moved, or this note is still being written.'}</p>
    <a class="text-link" href={lang === 'zh' ? '/zh/notes/' : '/notes/'}>{lang === 'zh' ? '返回全部笔记' : 'Back to all notes'} <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
