---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeFeed from '../components/HomeFeed.astro';
import { getPublishedNotes } from '../lib/notes';

const notes = await getPublishedNotes();
---

<BaseLayout description="Jason's personal notes on engineering, AI, and the things he keeps exploring." lang="en">
  <section class="home-page" aria-labelledby="blog-title">
    <div class="cover">
      <h1 id="blog-title" class="cover-title">Jason's Notes</h1>
      <p class="cover-description">Some things I'm researching and exploring: Engineer · AI · Lifestyle · Health · ……</p>
      <div class="cover-cta">
        <a class="button button-primary" href="https://github.com/zhguichen" rel="me">GitHub</a>
      </div>
    </div>

    <HomeFeed notes={notes} />
  </section>
</BaseLayout>
