---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { getPublishedNotes } from '../../lib/notes';

const notes = await getPublishedNotes('en');
const topics = [...new Set(notes.map((note) => note.data.topic))];
---

<BaseLayout title="Notes" description="Browse all of Jason's published notes by topic." lang="en">
  <header class="archive-hero">
    <h1>All Notes</h1>
    <p>Browse Jason's public notes by topic.</p>
  </header>
  <nav class="topic-index" aria-label="Topics">
    <span>Topics</span>
    {topics.map((topic) => <a href={`#${topic}`}>{topic}</a>)}
  </nav>
  {
    topics.map((topic) => {
      const topicNotes = notes.filter((note) => note.data.topic === topic);
      return (
        <section class="archive-group" id={topic} aria-labelledby={`${topic}-title`}>
          <h2 id={`${topic}-title`}>{topic}</h2>
          <NoteList notes={topicNotes} lang="en" />
        </section>
      );
    })
  }
</BaseLayout>
