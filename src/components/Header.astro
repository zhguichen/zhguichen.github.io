---
import { switchLanguage, type Lang } from '../lib/notes';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const path = Astro.url.pathname;
const links =
  lang === 'zh'
    ? [
        { href: '/zh/', label: '首页' },
        { href: '/zh/notes/', label: '笔记' },
        { href: '/zh/about/', label: '关于' }
      ]
    : [
        { href: '/', label: 'Home' },
        { href: '/notes/', label: 'Notes' },
        { href: '/about/', label: 'About' }
      ];
const switchTo = switchLanguage(path);
const switchLabel = lang === 'zh' ? 'EN' : '中文';
---

<header class="site-header">
  <a class="brand" href={lang === 'zh' ? '/zh/' : '/'} aria-label="Jason's Notes">
    <span class="brand-overline">JASON'S</span>
    <strong>Jason's Notes</strong>
  </a>
  <nav aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
    <ul class="site-nav">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="header-actions">
    <a class="lang-switch" href={switchTo}>{switchLabel}</a>
    <a class="header-rss" href={lang === 'zh' ? '/zh/rss.xml' : '/rss.xml'}>
      <span aria-hidden="true">↗</span>
      RSS
    </a>
  </div>
</header>
