---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/notes/', label: '笔记' },
  { href: '/about/', label: '关于' }
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Lottery Life 首页">
    <span class="brand-overline">JASON'S</span>
    <strong>Lottery Life</strong>
  </a>
  <nav aria-label="主导航">
    <ul class="site-nav">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a class="header-rss" href="/rss.xml">
    <span aria-hidden="true">↗</span>
    RSS
  </a>
</header>
