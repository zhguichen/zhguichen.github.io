---
import type { Note, Lang } from '../lib/notes';
import { formatDate, readingTime } from '../lib/notes';
import TagList from './TagList.astro';

interface Props {
  notes: Note[];
  compact?: boolean;
  minimal?: boolean;
  lang?: Lang;
}

const { notes, compact = false, minimal = false, lang = 'en' } = Astro.props;
const base = lang === 'zh' ? '/zh/notes' : '/notes';
---

<ol class:list={['note-list', { 'note-list--compact': compact }]}>
  {
    notes.map((note) => (
      <li>
        <article class="note-row">
          <div class="note-meta">
            <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date, lang)}</time>
            <span>{note.data.topic}</span>
          </div>
          <div class="note-main">
            <h3><a href={`${base}/${note.data.slug}/`}>{note.data.title}</a></h3>
            {!minimal && !compact && <p>{note.data.description}</p>}
            {!minimal && <div class="note-bottom">
              <TagList tags={note.data.tags} />
              <span class="reading-time">{readingTime(note)} {lang === 'zh' ? '分钟阅读' : 'min read'}</span>
            </div>}
          </div>
        </article>
      </li>
    ))
  }
</ol>
