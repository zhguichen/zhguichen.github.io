---
import type { Lang } from '../lib/notes';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
---

<footer class="site-footer">
  <p class="footer-title">JASON'S · NOTES</p>
  <p>{lang === 'zh' ? '记录 Engineer、AI、Lifestyle 与 Health 等有趣的事。' : 'Notes on engineering, AI, lifestyle, and health.'}</p>
  <div class="footer-links">
    <a href={lang === 'zh' ? '/zh/rss.xml' : '/rss.xml'}>RSS</a>
    <a href="https://github.com/zhguichen" rel="me">GitHub</a>
  </div>
</footer>
