---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  cover?: ImageMetadata;
  coverUrl?: string;
}

const {
  title,
  description = 'Jason 的个人笔记，记录技术、运动、生活与持续探索。',
  article = false,
  publishedAt,
  updatedAt,
  tags = [],
  cover,
  coverUrl
} = Astro.props;
const siteName = "Jason's Notes";
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const shareTitle = title ?? siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(coverUrl ?? cover?.src ?? '/og-default.png', Astro.site);
const socialImageWidth = cover?.width ?? 1200;
const socialImageHeight = cover?.height ?? 630;
const structuredData = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: [socialImage.href],
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      author: {
        '@type': 'Person',
        name: 'Jason',
        url: new URL('/about/', Astro.site).href
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonical.href
      },
      inLanguage: 'zh-CN',
      keywords: tags
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: new URL('/', Astro.site).href,
      description,
      inLanguage: 'zh-CN'
    };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="nfMo_uAzeuHlQ-ARnZXN-XMpWGr_6zwF8kRdOYBHQ4k" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0e11" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-055CVRKE74"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-055CVRKE74');
    </script>
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
